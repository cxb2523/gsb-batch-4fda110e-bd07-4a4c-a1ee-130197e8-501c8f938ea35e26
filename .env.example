# rakuten-scraper: example environment file.
#
# Copy this to `.env` beside the scripts (`cp .env.example .env`) and fill in
# the lines you need. `.env` is git-ignored; this example is not, so it can be
# committed and shared. Every value that needs filling in is written in
# BRACES: those read as unset, so a copied example never connects anywhere
# with a half-filled login.
#
# A flag typed on the command line always beats a value from this file.

# Your 2captcha API key. Needed only for the paid paths (--twocaptcha-key and
# --fingerprint); no captcha has ever been observed on rakuten.co.jp, so an
# ordinary run needs no key at all.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# The URL to scrape when you would rather not type --url. This is the value
# the README's quick start uses, so a copied example still runs untouched.
RAKUTEN_URL=https://search.rakuten.co.jp/search/mall/コーヒー/

# A proxy, optional. Credentials belong here and never on a command line.
# Replace {user} and {password} with the dashboard's login and password; the
# host is a GATEWAY (ap, na or eu) and the country is the -region-jp segment.
RAKUTEN_PROXY=http://{user}-zone-custom-region-jp:{password}@ap.proxy.2captcha.com:2334

# A 2captcha Scraping Browser endpoint, optional. Replace {login},
# {profileId} and {password}. A profile allows ONE live connection, so this
# cannot be combined with --concurrency above 1 or with --proxy.
RAKUTEN_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-jp-pid-{profileId}:{password}@cb.2captcha.com:9222
